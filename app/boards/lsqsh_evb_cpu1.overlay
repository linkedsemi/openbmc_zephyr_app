&espi1 {
    status = "okay";
    espi1_kcs0: espi1_kcs_ca2 {
        compatible = "linkedsemi,ls-kcs";
        kcs-env-addr = <0x40045d00>;
        port = <0xca2 0xca3>;
        status = "okay";
    };
};

