&ipmi_kcs {
    kcs_chan = <&espi1_kcs0>;
    status = "okay";
};

&caseopen {
    status = "okay";
};

&adc1 {
    #address-cells = <1>;
    #size-cells = <0>;
    pinctrl-0 = <&adc1_ain8_pc11 &adc1_ain9_pc12 &adc1_ain10_pc13>;
    pinctrl-names = "default";
    conversion_mode = <regular_mode>;
    data_align = <ADC_DATAALIGN_RIGHT>;
    continuous_conv_mode = <continuous>;
    nbr_of_conversion = <3>;
    discontinuous_conv_mode = <discontinuous>;
    nbr_of_disc_conversion = <0>;
    trig_type = <ADC_SOFTWARE_TRIGT>;
    adc_drive_type = <BINBUF_DIRECT_DRIVE_ADC>;
    adc_clk_div = <256>;
    clk_cfg = <ADC_CH_CLOCK_DIV8>;
    injected_offset = <0>;
    fif_ctrl1 = <0xFFFF>;
    #hwmon-in-cells = <1>;
    status = "okay";
};

/ {
    hwmon0 {
        compatible = "linkedsemi,hwmon";
        class = <0x2>;
        label = "hwmon0";
        hwmon-ins = <&adc1 0x8>, <&adc1 0x9>, <&adc1 0xa>;
        status = "okay";
    };

    /*
     * Generic model for class 5: set `sensor-type` and point `hwmon-ins`
     * directly at the underlying sensor device node (which implements the
     * Zephyr sensor API -- e.g. mps,mp5023 / ali,psu). No separate `sensor`
     * phandle is needed: the sensor node already provides #hwmon-in-cells
     * (via hwmon-controller.yaml), so `hwmon-ins = <&psu0 0>` carries the
     * sensor device handle. hwmon_i2c never touches bus registers; it only
     * calls sensor_sample_fetch()/sensor_channel_get(). The bus number and
     * address exposed in `bus_addr` are derived from the sensor node's parent
     * bus (`DT_BUS`) and `reg`, so no per-device code is needed in
     * hwmon_i2c.c.
     *
     * Example (PSU on i2c5 @ 0x60):
     *
     * &i2c5 {
     *     psu0: mp5023@60 {
     *         compatible = "mps,mp5023";
     *         reg = <0x60>;
     *         status = "okay";
     *     };
     * };
     *
     * hwmon_psu0 {
     *     compatible = "linkedsemi,hwmon";
     *     class = <0x5>;
     *     label = "hwmon_psu0";
     *     sensor-type = "psu";
     *     hwmon-ins = <&psu0 0>;
     *     meas = "in1_input:vin1", "in3_input:vout1",
     *            "curr1_input:iin1", "curr2_input:iout1",
     *            "power1_input:pin", "power2_input:pout1",
     *            "temp1_input", "fan1_input";
     *     status = "okay";
     * };
     *
     * `meas` lists the hwmon ABI files to expose. Each entry is
     * "<chan><n>_input" with an OPTIONAL ":<label>" suffix. hwmon_i2c parses
     * the filename at read time: prefix -> sensor_channel
     * (in/curr/power/temp/fan), number -> val2 rail selector (number - 1). So
     * in1=vin(val2=0), in3=vout(val2=2) for a PSU whose channel_get maps
     * voltage val2 0->vin, 2->vout.
     *
     * The ":<label>" suffix creates a companion "<chan><n>_label" file
     * (input->label) whose content is that text, e.g. in3_input:vout1 ->
     * in3_label = "vout1". This lets dbus-sensors tell vin/vout, iin/iout,
     * pin/pout apart (label heads vin1/vout1/iin1/iout1/pin/pout1). Drop the
     * ":<label>" (e.g. "temp1_input", "fan1_input") to skip the label file;
     * dbus-sensors then treats that rail with its generic "output" property.
     */

    hwmon_caseopen: hwmon_caseopen {
        compatible = "linkedsemi,hwmon";
        class = <0x5>;
        label = "hwmon_caseopen";
        sensor-type = "intrusion";
        hwmon-ins = <&caseopen 0>;
        meas = "intrusion1_input";
        status = "okay";
    };


    fstab {
        compatible = "zephyr,fstab";

        ro_lfs_a: ro_lfs_a{
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/ro";
            partition = <&a_rofs_partition>;
            no-format;
            read-only;
            read-size = <32>;
            prog-size = <32>;
            cache-size = <64>;
            lookahead-size = <256>;
            block-cycles = <512>;
        };
        rw_lfs: rw_lfs{
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/rw";
            partition = <&rwfs_partition>;
            // automount;
            // no-format;
            read-size = <32>;
            prog-size = <32>;
            cache-size = <64>;
            lookahead-size = <256>;
            block-cycles = <512>;
        };
    };
};
