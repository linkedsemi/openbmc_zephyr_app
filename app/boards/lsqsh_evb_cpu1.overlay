&ipmi_kcs {
    kcs_chan = <&espi1_kcs0>;
    status = "okay";
};

&adc1 {
    #address-cells = <1>;
    #size-cells = <0>;
    pinctrl-0 = <&adc1_ain8_pc11 &adc1_ain9_pc12 &adc1_ain10_pc13>;
    pinctrl-names = "default";
    conversion_mode = <regular_mode>;
    data_align = <ADC_DATAALIGN_RIGHT>;
    continuous_conv_mode = <continuous>;
    nbr_of_conversion = <3>;
    discontinuous_conv_mode = <discontinuous>;
    nbr_of_disc_conversion = <0>;
    trig_type = <ADC_SOFTWARE_TRIGT>;
    adc_drive_type = <BINBUF_DIRECT_DRIVE_ADC>;
    adc_clk_div = <256>;
    clk_cfg = <ADC_CH_CLOCK_DIV8>;
    injected_offset = <0>;
    fif_ctrl1 = <0xFFFF>;
    #hwmon-in-cells = <1>;
    status = "okay";
};

/ {
    hwmon0 {
        compatible = "linkedsemi,hwmon";
        class = <0x2>;
        label = "hwmon0";
        hwmon-ins = <&adc1 0x8>, <&adc1 0x9>, <&adc1 0xa>;
        status = "okay";
    };

    fstab {
        compatible = "zephyr,fstab";

        ro_lfs_a: ro_lfs_a{
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/ro";
            partition = <&a_rofs_partition>;
            no-format;
            read-only;
            read-size = <32>;
            prog-size = <32>;
            cache-size = <64>;
            lookahead-size = <256>;
            block-cycles = <512>;
        };
        rw_lfs: rw_lfs{
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/rw";
            partition = <&rwfs_partition>;
            // automount;
            // no-format;
            read-size = <32>;
            prog-size = <32>;
            cache-size = <64>;
            lookahead-size = <256>;
            block-cycles = <512>;
        };
    };
};
