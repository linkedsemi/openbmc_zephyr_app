&i2c5 {
    status = "okay";
    label = "i2c-5";
    eeprom_5_1: eeprom@50 {
        status = "okay";
        compatible = "atmel,at24";
        reg = <0x50>;
        size = <4096>;
        pagesize = <32>;
        address-width = <16>;
        timeout = <5>;
        label = "eeprom_5_1";
    };
};
