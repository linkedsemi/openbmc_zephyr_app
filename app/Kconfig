menuconfig DBROKER
	bool "D-Bus Broker support"
	default n
	help
		Enable D-Bus broker support for inter-process communication.

if DBROKER

choice
	prompt "D-Bus broker connection type"
	default DBUS_BROKER_INET

config DBUS_BROKER_INET
	bool "Use INET sockets"
	help
		Use AF_INET sockets for client connections.
		This requires network stack and uses more resources.

config DBUS_BROKER_SOCKETPOOL
	bool "Use socketpool"
	select NET_SOCKETPAIR
	help
		Use a pool of pre-allocated socketpairs for client connections.
		This is more efficient than INET sockets and uses less resources.

endchoice

config DBUS_BROKER_PORT
	int "D-Bus broker listening port"
	depends on DBUS_BROKER_INET
	default 55555
	help
		Port number for D-Bus broker listener.

config DBUS_BROKER_SOCKETPOOL_SIZE
	int "Number of socketpairs in pool"
	depends on DBUS_BROKER_SOCKETPOOL
	default 16
	help
		Number of pre-allocated socketpairs in the pool.
		Each socketpair uses 2 file descriptors.

config DBUS_BROKER_SOCKETPOOL_BUFFER_SIZE
	int "Socketpair buffer size in bytes"
	depends on DBUS_BROKER_SOCKETPOOL
	default 4096
	help
		Buffer size for each socketpair in the pool.
		This is the size of the socket send/receive buffer for each
		end of the socketpair. A larger buffer allows larger messages
		to be sent without blocking, but uses more memory.

		Total memory usage = SOCKETPOOL_SIZE * 2 * SOCKETPOOL_BUFFER_SIZE

		Examples:
		- 16 pairs * 2 * 4KB = 128KB
		- 16 pairs * 2 * 8KB = 256KB
		- 16 pairs * 2 * 16KB = 512KB

		For most D-Bus use cases, 4KB-8KB is sufficient.

config DBUS_BROKER_STACK_SIZE
	int "D-Bus broker thread stack size"
	default 8192
	help
		Stack size for D-Bus broker thread.

config DBUS_BROKER_PRIORITY
	int "D-Bus broker thread priority"
	default 7
	help
		Priority for D-Bus broker thread.

endif # DBROKER

config APP_STACK_SECTION
    string
    prompt "APP_STACK_SECTION"
    default "PSRAM"
    # default ".noinit"

config OPENBMC_ZEPHYR
	bool "OpenBMC project build (global control)"
	default y
	help
	  Global flag to indicate this is OpenBMC build.

config FS_ROOT_RO
    string
    prompt "Root filesystem read-only path"
    default "/ro"

config FS_ROOT_RW
    string
    prompt "Root filesystem read-write path"
    default "/rw"

config FS_ROOT_OVERLAY
    string
    prompt "Root filesystem overlay path"
    default "/overlay"

config FAKE_TEMP_SENSOR
	bool "Fake temperature sensor for hwmon self-test"
	default n
	help
	  A simulated sensor device that returns a slowly-varying temperature
	  (around 25 C) via the Zephyr sensor API. Use it to exercise the
	  hwmon_i2c -> sysfs tempX_input -> HwmonTempSensor dbus path without
	  real sensor hardware. Enable only for testing; keep off in production.

config FAKE_PSU_SENSOR
	bool "Fake PSU sensor for hwmon self-test"
	default n
	help
	  A simulated PMBus-style sensor returning slowly-varying voltage/power
	  rail values (vin/vout/pin/pout) via the Zephyr sensor API. Use it to
	  exercise the hwmon_i2c -> sysfs <rail>_input -> PSUSensor dbus path
	  without real PMBus hardware. Enable only for testing; keep off in
	  production.

config FAKE_PECI_CPUTEMP
	bool "Fake PECI CPU temperature/power sensor for hwmon self-test"
	default n
	help
	  A simulated Intel PECI CPU sensor returning slowly-varying temperature
	  (DTS, Margin, DIMM) and power (cpu power, dimm power) values via the
	  Zephyr sensor API. Use it to exercise the hwmon_i2c -> sysfs
	  *_input -> IntelCPUSensor dbus path without a real Intel CPU connected.
	  Enable only for testing; keep off in production.

config SENSOR_INTEL_PECI
	bool "Real Intel PECI CPU temperature/power/DIMM sensor"
	depends on PECI
	default n
	help
	  The real counterpart of FAKE_PECI_CPUTEMP. Reads DTS / Margin / Package
	  power / DRAM power / DIMM A1 / DIMM B1 from an Intel CPU over PECI
	  and exposes them via the Zephyr sensor API so hwmon_i2c + IntelCPUSensor
	  work without any code changes.

	  All six rails, including DIMM A1 / DIMM B1, are sourced from PECI:
	  the CPU's integrated memory controller (IMC) monitors the DIMM
	  thermistors itself and reports per-channel DIMM temperatures through
	  the PECI memory-thermal domain (RdPkgCfg with a memory-domain index,
	  or RdIAMSR for some platforms). The DIMM slot SMBus is reserved for
	  SPD / PMBus access and is NOT the temperature source.

	  Enable directly in prj.conf (NOT through a -D...=y build flag -- the
	  build flag is reserved for fake self-test sensors). When set, the
	  matching DT overlay (lsqsh_evb_cpu1_intel_peci.overlay) is applied
	  automatically and the SoC's &peci1/&peci2 nodes are enabled.

	  Typical prj.conf snippet for production:

	      CONFIG_PECI=y
	      CONFIG_PECI_LS=y
	      CONFIG_SENSOR_INTEL_PECI=y

	  Mutually exclusive with FAKE_PECI_CPUTEMP.

source "Kconfig.zephyr"
